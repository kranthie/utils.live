{
  "name": "@utils-live/tools",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.mjs",
    "./src/index.ts",
    "./src/tools/register.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "import": "./src/constants.ts",
      "require": "./src/constants.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist .turbo node_modules coverage",
    "generate:tool": "npx ts-node scripts/generate-tool.ts"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "@noble/ciphers": "2.1.1",
    "@noble/ed25519": "3.0.0",
    "acorn": "8.15.0",
    "bcryptjs": "3.0.3",
    "css-tree": "3.1.0",
    "diff": "5.2.0",
    "fast-xml-parser": "5.5.9",
    "hjson": "3.2.2",
    "ini": "4.1.0",
    "isomorphic-dompurify": "3.0.0",
    "jmespath": "0.16.0",
    "js-yaml": "4.1.0",
    "json5": "2.2.3",
    "marked": "17.0.0",
    "papaparse": "5.4.0",
    "qrcode": "1.5.4",
    "slugify": "1.6.6",
    "turndown": "7.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/css-tree": "2.3.11",
    "@types/diff": "5.2.0",
    "@types/hjson": "2.4.6",
    "@types/ini": "4.1.0",
    "@types/jmespath": "0.15.2",
    "@types/js-yaml": "4.0.9",
    "@types/node": "catalog:",
    "@types/papaparse": "5.3.14",
    "@types/qrcode": "1.5.6",
    "@types/turndown": "5.0.4",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "20.5.0",
    "ts-node": "10.9.2",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
