# ===========================================
# utils.live — Environment Configuration
# ===========================================
# Copy to .env.local and fill in the values.
# Next.js reads .env.local from this directory (apps/web/).

# -------------------------------------------
# App URL — used in sitemap/robots (defaults to https://utils.live)
# -------------------------------------------
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -------------------------------------------
# StaticForms — contact form submission
# -------------------------------------------
# NEXT_PUBLIC_STATICFORMS_API_KEY=""
